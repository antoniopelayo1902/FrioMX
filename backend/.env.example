PORT=3000
AWS_REGION=us-east-1

# Solo para desarrollo local con DynamoDB Local (en la nube no se define)
DDB_ENDPOINT=http://localhost:8000

# En la nube el secreto se lee de Secrets Manager; en local se define aquí
JWT_SECRET=

TABLE_USERS=friomx-users
TABLE_USER_EMAILS=friomx-user-emails
TABLE_ACTIVITY=friomx-activity
TABLE_WEEKLY_STATS=friomx-weekly-stats
TABLE_RECHARGES=friomx-recharges
TABLE_GAME_ROUNDS=friomx-game-rounds
TABLE_LEADERBOARD=friomx-leaderboard
APP_TZ=America/Mexico_City

# Opcionales en local: si faltan, fotos y recargas responden 503 y no hay avisos ni métricas.
# En la nube: JWT_SECRET_ARN (en lugar de JWT_SECRET), UPLOADS_BUCKET, RECHARGE_QUEUE_URL,
# USER_TOPIC_ARN, METRICS_NAMESPACE=FrioMx y METRICS_ENABLED=true.
UPLOADS_BUCKET=
RECHARGE_QUEUE_URL=
USER_TOPIC_ARN=
METRICS_ENABLED=false
